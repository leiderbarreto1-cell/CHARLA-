// Ruta crítica (PERT/CPM): preparar un almuerzo familiar
public class RutaCritica {

    public static void main(String[] args) {

        String[] nombres = {"Supermercado", "Poner mesa", "Lavar verduras", "Cocinar arroz",
                            "Freir pollo", "Hacer jugo", "Hacer ensalada", "Servir"};

        // Duración de cada actividad en minutos
        int[] duraciones = {40, 10, 15, 25, 30, 10, 10, 5};

        // previas[i] = actividades que deben terminar antes de la actividad i
        // (se escriben por su posición; {} significa que puede empezar de una vez)
        int[][] previas = {
            {},               // 0 Supermercado
            {},               // 1 Poner mesa
            {0},              // 2 Lavar verduras: después del supermercado
            {0},              // 3 Cocinar arroz: después del supermercado
            {0},              // 4 Freir pollo: después del supermercado
            {0},              // 5 Hacer jugo: después del supermercado
            {2},              // 6 Hacer ensalada: después de lavar verduras
            {1, 3, 4, 5, 6}   // 7 Servir: cuando todo lo demás esté listo
        };

        int n = nombres.length;

        // PASO 1: hacia adelante (lo más pronto que puede empezar y terminar cada una)
        int[] inicio = new int[n];
        int[] fin = new int[n];

        for (int i = 0; i < n; i++) {
            int mayor = 0;
            for (int k = 0; k < previas[i].length; k++) {
                int p = previas[i][k];
                if (fin[p] > mayor) {      // espero a la previa que termina más tarde
                    mayor = fin[p];
                }
            }
            inicio[i] = mayor;
            fin[i] = inicio[i] + duraciones[i];
        }

        // El tiempo total del proyecto es el fin más grande
        int total = 0;
        for (int i = 0; i < n; i++) {
            if (fin[i] > total) {
                total = fin[i];
            }
        }

        // PASO 2: hacia atrás (lo más tarde que puede empezar y terminar sin atrasar todo)
        int[] inicioTarde = new int[n];
        int[] finTarde = new int[n];

        for (int i = n - 1; i >= 0; i--) {     // se recorre de la última a la primera
            int menor = total;                 // si nadie depende de i, el límite es el total
            for (int j = 0; j < n; j++) {
                for (int k = 0; k < previas[j].length; k++) {
                    if (previas[j][k] == i) {  // la actividad j necesita a i
                        if (inicioTarde[j] < menor) {   // respeto a la que empieza primero
                            menor = inicioTarde[j];
                        }
                    }
                }
            }
            finTarde[i] = menor;
            inicioTarde[i] = finTarde[i] - duraciones[i];
        }

        // PASO 3: holgura = margen de retraso. Si es 0, la actividad es crítica
        System.out.println("Actividad | Inicio | Fin | Holgura");
        for (int i = 0; i < n; i++) {
            int holgura = inicioTarde[i] - inicio[i];
            System.out.println(nombres[i] + " | " + inicio[i] + " | " + fin[i] + " | " + holgura);
            if (holgura == 0) {
                System.out.println("   ^ esta actividad es CRITICA");
            }
        }

        System.out.println();
        System.out.println("Tiempo minimo del almuerzo: " + total + " minutos");
    }
}
